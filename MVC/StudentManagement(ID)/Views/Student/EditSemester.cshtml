@model StudentManagement_ID_.Models.Semester

<h2>Edit Semester</h2>

<form method="post" action="/Student/EditSemester">

    <input type="hidden" name="Id" value="@Model.Id">
    <input type="hidden" name="StudentId" value="@Model.StudentId">

    <label>Semester Name</label><br>
    <input type="text" name="Name" value="@Model.Name"><br><br>

    <label>GPA</label><br>
    <input type="number" step="0.01" name="GPA" value="@Model.GPA"><br><br>

    <button type="submit">Save Changes</button>

</form>

<br>

<a href="/Student/Semesters">
    <button>Back</button>
</a>