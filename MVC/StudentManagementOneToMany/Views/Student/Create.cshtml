@model StudentManagementOneToMany.Models.Student

<h2>Add Student</h2>

<form method="post">

    <label>Name</label>
    <input type="text" name="Name" />

    <br />

    <label>City</label>
    <input type="text" name="City" />

    <br />

    <label>Room Id</label>
    <input type="number" name="HostelRoomId" />

    <br />

    <label>Payment Amount</label>
    <input type="number" name="Payment.Amount" />

    <br />

    <label>Payment Status</label>
    <input type="text" name="Payment.PaymentStatus" />

    <br />

    <button type="submit">Save</button>

</form>